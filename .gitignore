# Run artifacts: regenerated by every run, never committed.
outputs/
# Any subdirectory under judge/ holds generated audit inputs, verdicts and score
# summaries; judge/RUBRIC.md and judge/*.py stay tracked.
judge/*/
judge/_manifest.json
judge/_overall.*
judge/_published_metrics.md
judge/*_leaderboard.*
judge/combined_passrate_factual.*

# Index build intermediates (the two shipped indexes themselves go through Git LFS; see .gitattributes).
data/indexes/*.sqlite3-*
data/indexes/*.building
data/indexes/build.lock
data/indexes/.vector_build_parts/

# Model weights are not committed: scripts/fetch_models.py downloads the pinned revisions here.
data/models/

# Environment and credentials.
.env
.env.*
!.env.example

# Python, virtual environments, system files.
__pycache__/
*.pyc
.venv/
.venv-mlx/
.DS_Store
*.log
