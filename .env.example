# Agent inference endpoint (OpenAI-compatible HTTP; no third-party SDK is used).
LOCAL_LIFE_API_BASE=https://your-openai-compatible-host.example/v1
# Use this instead when the gateway provides a full POST URL; it is used verbatim, with no /chat/completions appended.
# LOCAL_LIFE_API_URL=https://your-host.example/open_api/v1/chat
LOCAL_LIFE_API_KEY=replace_me
LOCAL_LIFE_MODEL=your_model
# One of: chat_completions, responses, anthropic.
LOCAL_LIFE_API_STYLE=chat_completions
LOCAL_LIFE_API_TIMEOUT=120
LOCAL_LIFE_API_RETRIES=3
LOCAL_LIFE_TEMPERATURE=0.1
# Some models (e.g. claude-opus-4-8) reject the temperature parameter.
# LOCAL_LIFE_OMIT_TEMPERATURE=true
LOCAL_LIFE_MAX_OUTPUT_TOKENS=4096
# Gateways exposing a thinking extension field (Qwen-style backends and similar) can switch thinking explicitly; unset means the field is not sent.
# LOCAL_LIFE_ENABLE_THINKING=false
# Which field carries the switch: extend_fields (gateway default) or chat_template_kwargs (the only one vLLM accepts).
# LOCAL_LIFE_THINKING_FIELD=chat_template_kwargs
# Reasoning effort, when the provider supports it (e.g. low/high/max for GLM); unset means the server default.
# LOCAL_LIFE_REASONING_EFFORT=low
# Thinking mode can loop on repetitions and burn the whole output budget; a mild repetition penalty breaks the loop. Unset means the parameter is not sent.
# LOCAL_LIFE_REPETITION_PENALTY=1.05

# Device for Qwen vector retrieval; auto tries CUDA, then Apple MPS, then CPU.
# LOCAL_LIFE_VECTOR_DEVICE=auto
# Override the Qwen reranker device separately; defaults to LOCAL_LIFE_VECTOR_DEVICE.
# LOCAL_LIFE_RERANKER_DEVICE=auto
# Optional: override the local embedding model cache directory.
# LOCAL_LIFE_VECTOR_CACHE=/path/to/cache
# Optional, MLX indexes only: override the converted local MLX embedding model directory.
# LOCAL_LIFE_MLX_MODEL_PATH=/path/to/Qwen3-Embedding-0.6B-mlx-fp16

# These aliases are also accepted: API_URL (exact URL), API_KEY, MODEL_NAME,
# plus OPENAI_BASE_URL, OPENAI_API_KEY and OPENAI_MODEL_NAME.
# The anthropic style is selected automatically when the model name contains claude, or the base URL contains /protocol/anthropic/.

# ---- ATLAS entry points (read by run_profile.py and the judge drivers; no real endpoint is bundled) ----
# Hosted model profiles: the key, plus one of BASE (OpenAI-compatible base) or URL (full POST URL).
# ATLAS_HOSTED_API_KEY=replace_me
# ATLAS_HOSTED_API_BASE=https://your-hosted-gateway.example/v1
# ATLAS_HOSTED_API_URL=https://your-hosted-gateway.example/open_api/v1/chat
# Local vLLM profiles default to http://127.0.0.1:8001/v1 with the placeholder key local-vllm; override only when the server listens elsewhere.
# ATLAS_LOCAL_API_BASE=http://127.0.0.1:8001/v1
# ATLAS_LOCAL_API_KEY=local-vllm
# Judge endpoint and key for all five judges; neither is needed with --dry-run.
# JUDGE_URL=https://your-judge-host.example/v1/chat
# ATLAS_JUDGE_URL=https://your-judge-host.example/v1/chat
# ATLAS_JUDGE_API_KEY=replace_me
# ATLAS_JUDGE_MODEL=deepseek-v4-pro
